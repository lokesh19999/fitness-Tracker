# Supabase configuration — placeholders only.
# The frontend uses ONLY the publishable/anon key. NEVER commit the service-role key.
# 1. Create a project at https://supabase.com
# 2. Copy .env.example to .env and fill in the values below.
# 3. Project Settings → API → Project URL and "anon public" key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
